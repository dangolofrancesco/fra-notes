---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { blogTopics } from '../content/config';

const pageTitle = "Blog";
const description = "Writing on quantitative finance, machine learning, and what I learn building things I don't fully understand yet.";

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const topicsWithPosts = blogTopics
  .map(topic => ({
    ...topic,
    posts: sortedPosts.filter(p => p.data.playlistSlug === topic.slug).slice(0, 2),
  }))
  .filter(topic => topic.posts.length > 0);

const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout pageTitle={pageTitle} description={description}>

  <!-- ════ HERO ════ -->
  <section class="relative w-full">
    <div class="aspect-[21/9] md:aspect-[21/7] w-full overflow-hidden relative bg-gray-900">
      <img
        src="/images/blog/hero_blog.png"
        alt="Blog hero image"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-900/45 to-gray-900/20"></div>
      <svg class="absolute inset-0 w-full h-full opacity-[0.12] mix-blend-soft-light" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
      <div class="absolute inset-0 flex items-end">
        <div class="w-[90%] mx-auto pb-8 md:pb-12">
          <h1 class="text-5xl md:text-7xl font-sans font-bold text-white leading-none">
            Blog
          </h1>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ INSPIRATIONAL STATEMENT ════ -->
  <section class="w-[90%] mx-auto md:mt-12 mb-24 grid grid-cols-1 md:grid-cols-12 gap-8">
    <div class="md:col-span-9 md:col-start-3">
      <h2 class="text-3xl md:text-4xl font-sans font-light leading-tight text-gray-500">
        I write about <span class="font-bold text-gray-900">quantitative finance</span>, <span class="font-bold text-gray-900">applied AI</span>, the <span class="font-bold text-gray-900">theory behind the code</span>, and what I learn <span class="font-bold text-[#E85D04]">building things I don't fully understand yet</span>.
      </h2>
    </div>
  </section>

  <!-- ════ INTRODUCTION ════ -->
  <section class="w-[90%] mx-auto pb-16 md:pb-24 border-b border-gray-200">
    <div class="max-w-2xl mx-auto">
      <p class="text-base md:text-lg text-gray-700 font-sans leading-tight mb-5">
        This is where I think out loud. Every project I build leaves me a trail of questions: why a model works, where it breaks, what I misunderstood. The blog is where I work through that trail.
      </p>
      <p class="text-base md:text-lg text-gray-700 font-sans leading-relaxed">
        I organize writing by topic, like playlists. Each one follows a single thread of learning over time. Start anywhere.
      </p>
    </div>
  </section>

  <!-- ════ TOPICS ════ -->
  {topicsWithPosts.map(topic => (
    <section class="w-[90%] mx-auto py-16 border-b border-gray-200 last:border-b-0">

      <div class="mb-10 max-w-3xl">
        <a href={`/blog/topic/${topic.slug}`} class="inline-block group/title">
          <h2 class="text-3xl md:text-4xl font-sans font-bold text-gray-900 mb-4 leading-tight group-hover/title:text-[#E85D04] transition-colors duration-300">
            {topic.title}
          </h2>
        </a>
        <p class="text-base md:text-lg text-gray-500 font-sans leading-relaxed">
          {topic.blurb}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 mb-10">
        {topic.posts.map(post => (
          <a href={`/blog/${post.slug}`} class="group block">
            <div class="aspect-[16/10] rounded-xl overflow-hidden mb-5 relative">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <div class="flex items-center gap-2 mb-3">
              {post.data.tags && post.data.tags[0] && (
                <span class="text-[10px] font-bold font-sans tracking-[0.2em] uppercase text-[#E85D04]">
                  {post.data.tags[0]}
                </span>
              )}
            </div>
            <h3 class="text-xl md:text-2xl font-serif font-bold text-gray-900 leading-snug mb-3 group-hover:text-[#E85D04] transition-colors duration-300">
              {post.data.title}
            </h3>
            <p class="text-gray-500 font-sans text-sm md:text-base leading-relaxed line-clamp-2 mb-3">
              {post.data.description}
            </p>
            <div class="flex items-center gap-3 text-xs text-gray-400 font-sans">
              <span>{formatDate(post.data.date)}</span>
              {post.data.readingTime && (<><span>·</span><span>{post.data.readingTime} min read</span></>)}
            </div>
          </a>
        ))}
      </div>

      <a href={`/blog/topic/${topic.slug}`} class="inline-flex items-center gap-2 text-sm font-bold font-sans uppercase tracking-widest text-gray-900 hover:text-[#E85D04] transition-colors group">
        Explore {topic.name}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>

    </section>
  ))}

  {sortedPosts.length === 0 && (
    <section class="w-[90%] mx-auto my-24 text-center">
      <p class="text-gray-400 font-sans italic">No posts yet. Check back soon.</p>
    </section>
  )}

</BaseLayout>
