---
const { 
  title, 
  description, 
  url, 
  image, 
  tags, 
  date, 
  readingTime,
  playlist,
  variant = "compact"   // "featured" | "compact" | "playlist-hero"
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', { 
  year: 'numeric', month: 'long', day: 'numeric' 
});
---

<!-- ─────────────────────────────────────────────────────────────
  VARIANT: playlist-hero
  Full-width banner introducing a playlist topic. No article link —
  just the playlist title, a one-liner, and the accent bar.
───────────────────────────────────────────────────────────────── -->
{variant === "playlist-hero" && (
  <div class="w-full mb-12">
    <div class="w-full h-px bg-gray-200 mb-8"></div>
    <div class="flex items-start gap-6">
      <div class="hidden md:block flex-shrink-0 mt-1">
        <div class="w-1 h-16 bg-[#E85D04] rounded-full"></div>
      </div>
      <div>
        <span class="text-[10px] font-bold font-sans tracking-[0.2em] uppercase text-[#E85D04] block mb-3">
          Playlist
        </span>
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 leading-tight mb-4">
          {title}
        </h2>
        <p class="text-lg md:text-xl text-gray-500 font-sans leading-relaxed max-w-2xl">
          {description}
        </p>
      </div>
    </div>
  </div>
)}

<!-- ─────────────────────────────────────────────────────────────
  VARIANT: featured
  Large card — image on right (desktop), text on left. 
  Used for the first article of a playlist.
───────────────────────────────────────────────────────────────── -->
{variant === "featured" && (
  <article class="group w-full mb-16">
    <a href={url} class="block">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-0 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-500 border border-gray-100">
        
        <!-- Text side -->
        <div class="md:col-span-5 flex flex-col justify-between p-8 md:p-10 bg-white order-2 md:order-1">
          
          <div>
            <div class="flex items-center gap-3 mb-5">
              <span class="text-[10px] font-bold font-sans tracking-[0.2em] uppercase text-[#E85D04]">
                {playlist}
              </span>
              {tags && tags[0] && (
                <>
                  <span class="text-gray-300">·</span>
                  <span class="text-[10px] font-bold font-sans tracking-[0.2em] uppercase text-gray-400">
                    {tags[0]}
                  </span>
                </>
              )}
            </div>

            <h3 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 leading-snug mb-4 group-hover:text-[#E85D04] transition-colors duration-300">
              {title}
            </h3>

            <p class="text-gray-500 font-sans text-sm md:text-base leading-relaxed line-clamp-4">
              {description}
            </p>
          </div>

          <div class="flex items-center justify-between mt-8 pt-6 border-t border-gray-100">
            <div class="flex items-center gap-3 text-xs text-gray-400 font-sans">
              <span>{formattedDate}</span>
              {readingTime && (
                <>
                  <span>·</span>
                  <span>{readingTime} min read</span>
                </>
              )}
            </div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#E85D04] group-hover:translate-x-1 transition-transform duration-300">
              Read →
            </span>
          </div>
        </div>

        <!-- Image side -->
        <div class="md:col-span-7 overflow-hidden aspect-[16/10] md:aspect-auto order-1 md:order-2">
          <img 
            src={image} 
            alt={title}
            class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
          />
        </div>

      </div>
    </a>
  </article>
)}

<!-- ─────────────────────────────────────────────────────────────
  VARIANT: compact
  Smaller card — image on top, text below. 
  Used for subsequent articles in a playlist grid.
───────────────────────────────────────────────────────────────── -->
{variant === "compact" && (
  <article class="group flex flex-col h-full">
    
    <a href={url} class="block overflow-hidden rounded-xl mb-5 aspect-[16/10] relative">
      <img 
        src={image} 
        alt={title}
        class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500"></div>
    </a>

    <div class="flex flex-col flex-1 justify-between">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[10px] font-bold font-sans tracking-[0.2em] uppercase text-[#E85D04]">
            {playlist}
          </span>
          {tags && tags[0] && (
            <>
              <span class="text-gray-300 text-xs">·</span>
              <span class="text-[10px] font-bold font-sans tracking-[0.2em] uppercase text-gray-400">
                {tags[0]}
              </span>
            </>
          )}
        </div>

        <a href={url} class="block">
          <h3 class="text-xl font-serif font-bold text-gray-900 leading-snug mb-3 group-hover:text-[#E85D04] transition-colors duration-300">
            {title}
          </h3>
        </a>

        <p class="text-gray-500 font-sans text-sm leading-relaxed line-clamp-3">
          {description}
        </p>
      </div>

      <div class="flex items-center gap-3 mt-5 text-xs text-gray-400 font-sans">
        <span>{formattedDate}</span>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime} min read</span>
          </>
        )}
      </div>

    </div>
  </article>
)}
